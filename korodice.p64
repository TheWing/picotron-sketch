:: dice.lua
--[[pod_format="raw",created="2024-09-04 07:48:31",modified="2024-09-05 21:28:28",revision=1154]]
DC=6
DB=21
dice={x=8,y=1,top=6,bottom=1,up=5,down=2,left=3,right=4}
puck={x=0,y=0}

function move_dice(dir,force)
	local d=dice
	local b=board
	local possible=true
	local fx,fy=d.x,d.y
	local dx,dy=puck.x,puck.y
	-- check if we can move	
	if not force then
		-- where are we moving?
		if dir%4==0 then 
			fx=d.x-1
		elseif dir%4==1 then 
			fx=d.x+1
		elseif dir%4==2 then 
			fy=d.y-1
		elseif dir%4==3 then 
			fy=d.y+1
		end
		if fx==dx and fy==dy then	
			possible=check_puck(dir,fx,fy)
		end
		local ct=b[d.y][d.x]
		-- trying to move outside?
		if fx>8 or fx<1 or fy>8 or fy<1 then 
			possible=false
		else
			local ft=b[fy][fx]
			-- trying to move into a wall
			if ft==BLOCK or ft==FOLLOW then 
				possible=false
			end
			-- trying to move on goal but 1 won't be up?
			if ft==GOAL then
				if dir%4==0 and d.right!=1 then 
					possible=false
				end
				if dir%4==3 and d.up!=1 then
					possible=false
				end
				if possible then
					VICTORY=true
					sfx(2,nil,5) 
					music(5)
				else
					sfx(1)
				end
		
			end
			-- are we on an arrow?
			if ct==UP or ct==DOWN or ct==LEFT or ct==RIGHT then 
				-- does the direction not match?
				if (ct==UP and dir!=2) or (ct==DOWN and dir!=3) or (ct==LEFT and dir!=0) or (ct==RIGHT and dir!=1) then
					possible=false
				else
					board[d.y][d.x]=DIR[dir%4+1]
					if d.x==1 and DIR[dir%4+1]==LEFT then
						board[d.y][d.x]=UP
					end
					if d.x==8 and DIR[dir%4+1]==RIGHT then
						board[d.y][d.x]=DOWN
					end
					if d.y==1 and DIR[dir%4+1]==UP then
						board[d.y][d.x]=RIGHT
					end
					if d.y==8 and DIR[dir%4+1]==DOWN then
						board[d.y][d.x]=LEFT
					end
				end
			end	
		end
	end
	if possible then
		-- actually move
		if dir%4==2 then --up
			d=rot_up(d)
		elseif dir%4==1 then --right
			d=rot_right(d)
		elseif dir%4==3 then --down
			d=rot_down(d)
		elseif dir%4==0 then --left
			d=rot_left(d)
		end
	end
	return d
end
function check_puck(dir,fx,fy)
	local d=puck
	local b=board
	local possible=true
	local dx,xy=dice.x,dice.y
	if dir%4==0 then 
			fx=d.x-1
		elseif dir%4==1 then 
			fx=d.x+1
		elseif dir%4==2 then 
			fy=d.y-1
		elseif dir%4==3 then 
			fy=d.y+1
		end
		local ct=b[d.y][d.x]
		-- trying to move outside?
		if fx>8 or fx<1 or fy>8 or fy<1 then 
			possible=false
		else
			local ft=b[fy][fx]
			-- trying to move into a wall
			if ft==BLOCK then 
				possible=false
			end
			if fx==dx and fy==dy then	
				possible=false
			end
		end
	return possible
end
function move_puck(dir,force)
	local d=puck
	local b=board
	local possible=true
	local fx,fy=d.x,d.y
	local dx,xy=dice.x,dice.y
	-- check if we can move	
	if not force then
		-- where are we moving?
		possible=check_puck(dir,fx,fy)
	end
	if possible then
		-- actually move
		if dir%4==2 then --up
			d.y=d.y-1
		elseif dir%4==1 then --right
			d.x=d.x+1
		elseif dir%4==3 then --down
			d.y=d.y+1
		elseif dir%4==0 then --left
			d.x=d.x-1
		end
	end
	
	return d
end


function rot_up(d)
	local t=d
	d.y=d.y-1
	d.top,d.down,d.bottom,d.up=t.down,t.bottom,t.up,t.top
	return d
end
function rot_down(d)
	local t=d
	d.y=d.y+1
	d.top,d.down,d.bottom,d.up=t.up,t.top,t.down,t.bottom
	return d
end
function rot_left(d)
	local t=d
	d.x=d.x-1
	d.top,d.left,d.bottom,d.right=t.right,t.top,t.left,t.bottom
	return d
end
function rot_right(d)
	local t=d
	d.x=d.x+1
	d.top,d.left,d.bottom,d.right=t.left,t.bottom,t.right,t.top
	return d
end


function draw_roll(d,xx,yy,dir)
	local x,y=xx,yy
	local f=SFRAME-FRAME
	local w,h=12,12
	x=x-w*5+5+d.x*w-4
	y=y-h*4+5+d.y*h-1
	
	if f==1 then 
		if dir%4==0 then		--left
			x=x+w
			draw_hori_frame2(x,y,DC,DB)
		elseif dir%4==1 then	--right
			draw_hori_frame1(x,y,DC,DB)
		elseif dir%4==2 then	--up
			y=y+h
			draw_vert_frame1(x,y,DC,DB)
		elseif dir%4==3 then	--down
			draw_vert_frame2(x,y,DC,DB)
		end
	end
	if f==2 then 
		if dir%4==0 then		--left
			x=x+w
			draw_hori_frame1(x,y,DC,DB)
		elseif dir%4==1 then	--right
			draw_hori_frame2(x,y,DC,DB)
		elseif dir%4==2 then	--up
			y=y+h
			draw_vert_frame2(x,y,DC,DB)
		elseif dir%4==3 then	--down
			draw_vert_frame1(x,y,DC,DB)
		end
	end
	--pset(x,y,8)
	--print(f,x,y,8)
end	

function draw_hori_frame1(x,y,c,c2)
	y=y-1
	rectfill(x,y-8,x+6,y+12,c)
	rectfill(x+7,y-9,x+12,y+11,c)
	line(x,y-8,x+12,y-9,c2)
	line(x,y+2,x+12,y+1,c2)
	line(x-1,y-8,x-1,y+2,c2)
	line(x,y+2,x,y+12,c2)
	line(x,y+12,x+13,y+11,c2)
	line(x+13,y+11,x+13,y-9,c2)
end
function draw_hori_frame2(x,y,c,c2)
	--fill
	line(x-4,y-8,x+3,y-8,c)
	line(x-6,y-7,x+5,y-7,c)
	line(x-8,y-6,x+7,y-6,c)
	rectfill(x-9,y-5,x+7,y+7,c)
	line(x-3,y+10,x+2,y+10,c)
	line(x-5,y+9,x+4,y+9,c)
	line(x-7,y+8,x+6,y+8,c)
	--outline
	line(x-1,y-9,x-1,y+2,c2)
	line(x-9,y-5,x-9,y+7,c2)
	line(x+7,y-6,x+7,y+7,c2)
	line(x-2,y-9,x+1,y-9,c2)
	line(x-1,y-9,x-8,y-6,c2)
	line(x,y-9,x+7,y-6,c2)
	line(x,y+3,x+7,y+6,c2)
	line(x-2,y+3,x-9,y+6,c2)
	line(x,y+11,x-9,y+7,c2)
	line(x-1,y+11,x+6,y+8,c2)
end
function draw_vert_frame1(x,y,c,c2)
	rectfill(x+2,y-12,x+19,y-8,c)
	rectfill(x+1,y-9,x+18,y-4,c)
	rectfill(x,y-5,x+17,y-1,c)
	line(x+2,y,x+17,y,c)
	line(x+2,y-13,x+15,y-13,c)
	line(x+4,y+1,x+17,y+1,c2)
	line(x+2,y-14,x+15,y-14,c2)
	line(x+2,y-12,x,y-3,c2)
	line(x+2,y-14,x+2,y-12,c2)
	line(x,y-3,x,y-1,c2)
	line(x,y-1,x+5,y+1,c2)
	line(x+5,y+1,x+5,y-3,c2)
	line(x+6,y-4,x+6,y-7,c2)
	line(x+7,y-8,x+7,y-11,c2)
	line(x+7,y-12,x+2,y-14,c2)
	line(x+7,y-12,x+19,y-12,c2)
	line(x+17,y-13,x+16,y-13,c2)
	line(x+19,y-12,x+19,y-8,c2)
	line(x+18,y-7,x+18,y-4,c2)
	line(x+17,y-3,x+17,y,c2)
end
function draw_vert_frame2(x,y,c,c2)
	rectfill(x+4,y-10,x+16,y+4,c)
	line(x+4,y+5,x+15,y+5,c)
	line(x+1,y-4,x+1,y+2,c)
	line(x+2,y-6,x+2,y+4,c)
	line(x+3,y-8,x+3,y+6,c)
	line(x+17,y-8,x+17,y+2,c)
	line(x+18,y-6,x+18,y,c)
	line(x+19,y-4,x+17,y,c)
	
	line(x,y,x,y-2,c2)
	line(x,y-1,x+3,y+6,c2)
	line(x+3,y+6,x+15,y+6,c2)
	line(x+15,y+5,x+19,y-3,c2)
	line(x+19,y-4,x+7,y-4,c2)
	line(x+3,y+5,x+7,y-3,c2)
	line(x,y-1,x+4,y-10,c2)
	line(x+4,y-10,x+16,y-10,c2)
	line(x+4,y-9,x+7,y-4,c2)
	line(x+19,y-4,x+16,y-10,c2)
end

function draw_dice(d,xx,yy)
	local x,y=xx,yy
	local w,h=12,12
	x=x-w*5+5+d.x*w+7+JUMP
	y=y-h*4+5+d.y*h-2-JUMP
	draw_left(d.left,x,y,w,h,DC,DB)
	draw_down(d.down,x,y,w,h,DC,DB)
	draw_top(d.top,x,y,w,h,DC,DB)
end

function draw_puck(d,xx,yy)
	local x,y=xx,yy
	local w,h=12,12
	x=x-w*6+5+d.x*w+8
	y=y-h*4+5+d.y*h-2
	spr(64+8,x,y)
end

function draw_left(n,x,y,w,h,c,c2)
	local i=0
	x=x-w/2
	y=y-h/2
	w=w*(6/12)
	for i=0,w do
		if i==w then 
			line(x-i,y+i,x-i,y+h+i,c2)
		else
			line(x-i,y+i,x-i,y+h+i,c)
		end
	end
	for i=0,w do
		pset(x-i,y+i,c2)
		pset(x-i,y+h+i,c2)
	end
	x=x-w
	y=y+h
	if n==1 then
		x=x+3
		y=y-3
		ovalfill(x-1,y-2,x+1,y+2,c2)	
	elseif n==2 then
		if dice.top==3 or dice.top==4 then
			line(x+2,y-4,x+2,y-6,c2)
			line(x+4,y,x+4,y-2,c2)
		else
			line(x+4,y-6,x+4,y-8,c2)
			line(x+2,y+2,x+2,y,c2)
		end
	elseif n==3 then
		if dice.top==5 or dice.top==2 then
			line(x+2,y-4,x+2,y-6,c2)
			line(x+3,y-2,x+3,y-4,c2)
			line(x+4,y,x+4,y-2,c2)
		else
			line(x+4,y-6,x+4,y-8,c2)
			line(x+3,y-2,x+3,y-4,c2)
			line(x+2,y+2,x+2,y,c2)
		end
	elseif n==4 then
		line(x+2,y-4,x+2,y-6,c2)
		line(x+4,y,x+4,y-2,c2)
		line(x+4,y-6,x+4,y-8,c2)
		line(x+2,y+2,x+2,y,c2)
	elseif n==5 then
		line(x+2,y-4,x+2,y-6,c2)
		line(x+4,y,x+4,y-2,c2)
		line(x+4,y-6,x+4,y-8,c2)
		line(x+2,y+2,x+2,y,c2)
		line(x+3,y-2,x+3,y-4,c2)
	elseif n==6 then
		if dice.top==5 or dice.top==2 then
		line(x+2,y-5,x+2,y-6,c2)
		line(x+2,y-1,x+2,y-3,c2)
		line(x+2,y+2,x+2,y+1,c2)
		
		line(x+4,y-1,x+4,y-2,c2)
		line(x+4,y-4,x+4,y-6,c2)
		line(x+4,y-7,x+4,y-8,c2)
		else
			line(x+1,y-3,x+1,y-5,c2)
			line(x+3,y-5,x+3,y-7,c2)
			line(x+5,y-7,x+5,y-9,c2)
			line(x+1,y+3,x+1,y+1,c2)
			line(x+3,y+1,x+3,y-1,c2)
			line(x+5,y-1,x+5,y-3,c2)
		end
	end
end
function draw_down(n,x,y,w,h,c,c2)
	local i=0
	x=x-w/2
	y=y+h/2
	h=h*(6/12)
	for i=0,h do
		if i==h then 
			line(x-i,y+i,x+w-i,y+i,c2)
		else
			line(x-i,y+i,x+w-i,y+i,c)
		end
	end
	for i=0,h do
		pset(x-i,y+i,c2)
		pset(x+w-i,y+i,c2)
	end
	if n==1 then
		x=x+3
		y=y+3
		ovalfill(x-2,y-1,x+2,y+1,c2)
	elseif n==2 then
		if dice.top==6 or dice.top==1 then
			line(x+4,y+4,x+6,y+4,c2)
			line(x,y+2,x+2,y+2,c2)
		else
			line(x-2,y+4,x,y+4,c2)
			line(x+6,y+2,x+8,y+2,c2)
		end
	elseif n==3 then
		if dice.top==6 or dice.top==1 then
			line(x+4,y+4,x+6,y+4,c2)
			line(x+2,y+3,x+4,y+3,c2)
			line(x,y+2,x+2,y+2,c2)
		else
			line(x-2,y+4,x,y+4,c2)
			line(x+2,y+3,x+4,y+3,c2)
			line(x+6,y+2,x+8,y+2,c2)
		end
	elseif n==4 then
		line(x+4,y+4,x+6,y+4,c2)
		line(x,y+2,x+2,y+2,c2)
		line(x-2,y+4,x,y+4,c2)
		line(x+6,y+2,x+8,y+2,c2)
	elseif n==5 then
		line(x+4,y+4,x+6,y+4,c2)
		line(x,y+2,x+2,y+2,c2)
		line(x-2,y+4,x,y+4,c2)
		line(x+2,y+3,x+4,y+3,c2)
		line(x+6,y+2,x+8,y+2,c2)
	elseif n==6 then
		if dice.top==5 or dice.top==2 then
			line(x+5,y+4,x+6,y+4,c2)
			line(x,y+2,x+1,y+2,c2)
			line(x-2,y+4,x-1,y+4,c2)
			line(x+7,y+2,x+8,y+2,c2)
			line(x+1,y+4,x+3,y+4,c2)
			line(x+3,y+2,x+5,y+2,c2)
		else
			line(x-2,y+5,x,y+5,c2)
			line(x,y+3,x+2,y+3,c2)
			line(x+2,y+1,x+4,y+1,c2)
			x=x+5
			line(x-2,y+5,x,y+5,c2)
			line(x,y+3,x+2,y+3,c2)
			line(x+2,y+1,x+4,y+1,c2)
		end
	end
end

function draw_top(n,x,y,w,h,c,c2)
	rectfill(x-w/2,y-h/2,x+w/2,y+h/2,c)
	rect(x-w/2,y-h/2,x+w/2,y+h/2,c2)
	if n==1 then
		circfill(x,y,2,c2)
	elseif n==2 then
		if dice.up==4 or dice.up==3 then
			rectfill(x-4,y+4,x-2,y+2,c2)
			rectfill(x+4,y-4,x+2,y-2,c2)
		else
			rectfill(x-4,y-4,x-2,y-2,c2)
			rectfill(x+4,y+4,x+2,y+2,c2)
		end
	elseif n==3 then
		if dice.up==5 or dice.up==2 then
			rectfill(x-4,y+4,x-2,y+2,c2)
			rectfill(x+4,y-4,x+2,y-2,c2)
		else
			rectfill(x-4,y-4,x-2,y-2,c2)
			rectfill(x+4,y+4,x+2,y+2,c2)
		end
		rectfill(x-1,y-1,x+1,y+1,c2)
	elseif n==4 then
		rectfill(x-4,y-4,x-2,y-2,c2)
		rectfill(x+4,y+4,x+2,y+2,c2)
		rectfill(x-4,y+4,x-2,y+2,c2)
		rectfill(x+4,y-4,x+2,y-2,c2)
	elseif n==5 then
		rectfill(x-4,y-4,x-2,y-2,c2)
		rectfill(x+4,y+4,x+2,y+2,c2)
		rectfill(x-4,y+4,x-2,y+2,c2)
		rectfill(x+4,y-4,x+2,y-2,c2)
		rectfill(x-1,y-1,x+1,y+1,c2)
	elseif n==6 then
		if dice.up==4 or dice.up==3 then
			rectfill(x-4,y-4,x-2,y-3,c2)
			rectfill(x+4,y-4,x+2,y-3,c2)
			rectfill(x+4,y-1,x+2,y+1,c2)
			rectfill(x-4,y-1,x-2,y+1,c2)
			rectfill(x+4,y+4,x+2,y+3,c2)
			rectfill(x-4,y+4,x-2,y+3,c2)
		else
			rectfill(x-4,y-4,x-3,y-2,c2)
			rectfill(x+4,y+4,x+3,y+2,c2)
			rectfill(x-4,y+4,x-3,y+2,c2)
			rectfill(x+4,y-4,x+3,y-2,c2)
			rectfill(x-1,y-4,x+1,y-2,c2)
			rectfill(x-1,y+4,x+1,y+2,c2)
		end
	end
end
:: gameplay.lua
--[[pod_format="raw",created="2024-09-03 23:23:06",modified="2024-09-05 21:28:28",revision=875]]


function draw_clock(t,x,y)
	local m,s=0,0
	s=math.floor(t)
	m=s//60
	s=s%60
	if #tostring(s)==1 then 
		s="0"..s
	end
	if #tostring(m)==1 then 
		m="0"..m
	end
	spr(22,x-24,y)
	spr(23,x-16,y)
	spr(30,x-8,y)
	spr(31,x-24,y+8)
	spr(38,x-16,y+8)
	spr(39,x-8,y+8)
	tile_print(m..":"..s,x,y)
end

function draw_stage(t,x,y)
	local s=math.floor(t)
	local oy=0
	if #tostring(s)==1 then 
		s="0"..s
	end
	for i=40,47 do
		if (i-40)%8>=4 then
			oy=1
		else
			oy=0
		end
		spr(i,x-32+((i-40)%4)*8,y+8*oy)
	end
	tile_print(s,x,y)
end
	

function draw_background(x,y,t)
	local xx,yy=x,y
	x=x-TW/2
	y=y-TH/2
	cls()
	rectfill(x-1,y-1,x+TW,y+TH,7)
	t=max(t,0)
	draw_clock(tostring(t),xx-8*5,yy-TH/2+8)
	rect(xx-12*5+12,yy-12*4+15,xx+12*3+12,yy+12*4+15,5)
	map(0,0,x,y)
	draw_stage(LEVEL,xx+8*6,yy-TH/2+8)
end

function draw_level(l,x,y)
	local w,h=8*12,8*12
	x=x-12*5+1
	y=y-12*4+3
	local xx,yy=0,0
	for xx=1,8 do
		for yy=1,8 do
			spr(l[yy][xx]+64,x+12*xx,y+12*yy)
		end	
	end
end		

function tile_number(num,x,y)
	palt()
	spr(num+1,x,y)
end
function tile_colon(x,y)
	palt()
	spr(11,x,y)
end

function tile_print(text,x,y)
	local xx,yy=x,y
	for i=1,#text do
		local c = text:sub(i,i)
		local n = tonumber(c)
		if n==nil then 
			if c==":" then
				tile_colon(xx,yy)
			end
		else
			tile_number(n,xx,yy)
		end
		xx=xx+8
	end	
end
